  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.7",
    "@vitejs/plugin-vue": "6.0.1",
    "@vitest/coverage-v8": "3.2.4",
    "@vue/test-utils": "2.4.6",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.8.0",
    "globals": "14.0.0",
    "jsdom": "27.0.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vite": "7.3.6",
    "vitest": "3.2.4",
    "vue-tsc": "3.1.4"
